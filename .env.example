# ============================================================
# MAX Messenger — переменные окружения
# ============================================================
# Скопируйте этот файл в .env.local и при необходимости измените.
#
# ВАЖНО: .env и .env.local не коммитятся в репозиторий (см. .gitignore).
# Учётные данные GREEN-API (idInstance, apiTokenInstance) НЕ хранятся
# в .env — пользователь вводит их через интерфейс, они сохраняются
# в localStorage через Zustand persist middleware.
# ============================================================

# Платформа GREEN-API: 'whatsapp' (по умолчанию) или 'max'.
# При появлении поддержки MAX достаточно изменить это значение —
# код адаптируется автоматически через utils/phoneFormat.ts.
VITE_API_PLATFORM=whatsapp